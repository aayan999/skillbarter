# PostgreSQL connection string.
# If left empty, the app runs on an embedded local PostgreSQL (PGlite, files in
# .pglite-data/) so the demo works with zero external setup. Set this to a real
# PostgreSQL URL (e.g. Neon / Vercel Postgres) for deployment.
DATABASE_URL=

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that automatically become admin accounts on registration.
ADMIN_EMAILS=

# Pusher Channels (real-time chat, SRS section 3.3). If unset, chat still works
# through 3-second polling; Pusher only makes delivery instant.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Where session files / short videos are stored (local disk for the demo).
UPLOAD_DIR=./uploads

# Cloudinary (session file/video storage, REQ-12). If unset, uploads fall back
# to local disk (UPLOAD_DIR), which does not persist on serverless platforms.
# Cloud name, API key and secret from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
